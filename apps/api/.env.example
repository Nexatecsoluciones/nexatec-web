# Copiar a .env y completar. La aplicacion NO arranca si falta una variable
# obligatoria ni usa valores por defecto inseguros en produccion.

# Entorno: development | test | staging | production
NEXATEC_ENV=development

# PostgreSQL del control plane (base nexatec_control, rol de minimo privilegio)
NEXATEC_CONTROL_DB_HOST=127.0.0.1
NEXATEC_CONTROL_DB_PORT=5432
NEXATEC_CONTROL_DB_NAME=nexatec_control
NEXATEC_CONTROL_DB_USER=nexatec_app
NEXATEC_CONTROL_DB_PASSWORD=CHANGE_ME

# Rol de PostgreSQL separado, usado SOLO por el servicio de provisioning
# para crear DB/rol por tenant+sistema+entorno (CREATEDB+CREATEROLE, nunca
# SUPERUSER). El rol de arriba (control_db_user) no tiene esos permisos.
NEXATEC_PROVISIONER_DB_HOST=127.0.0.1
NEXATEC_PROVISIONER_DB_PORT=5432
NEXATEC_PROVISIONER_DB_USER=nexatec_provisioner
NEXATEC_PROVISIONER_DB_PASSWORD=CHANGE_ME

# Clave simetrica para cifrar en reposo las passwords de las DBs de tenant.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXATEC_DB_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# Puerto de la API (nunca hardcodeado)
NEXATEC_API_PORT=4301

# Sesiones: clave secreta para firmar cookies de sesion (generar con
# `openssl rand -hex 32`). Distinta entre development/staging/production.
NEXATEC_SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_HEX

# Cookies de sesion: nombre y duracion
NEXATEC_SESSION_COOKIE_NAME=nexatec_session
NEXATEC_SESSION_MAX_AGE_SECONDS=28800

# Origenes permitidos para CORS (lista separada por comas, nunca "*").
# Con el BFF same-origin (apps/web/src/app/api/[...path]/route.ts) el
# navegador ya no llama directo a esta API, asi que esto es sobre todo
# defensa en profundidad. En staging: el origen publico real.
NEXATEC_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4302

# Cloudflare Turnstile. Server-side, exige NEXATEC_ENV=development para
# poder omitirse (ver app/security/turnstile.py) -- nunca por estar en
# "no produccion" en general. Para desbloquear staging sin la cuenta
# real todavia, se pueden usar las claves de PRUEBA publicas y
# documentadas por Cloudflare (siempre aprueban, no son un secreto real):
# site key  1x00000000000000000000AA
# secret key 1x0000000000000000000000000000000AA
# Reemplazar por las reales antes de exponer staging sin Cloudflare Access,
# o antes de produccion.
NEXATEC_TURNSTILE_SITE_KEY=
NEXATEC_TURNSTILE_SECRET_KEY=

# Storage S3-compatible (Garage, self-hosted -- ver docs/ARCHITECTURE.md
# seccion Storage sobre por que no es MinIO). Nunca se expone al cliente:
# la API genera URLs firmadas de corta duracion bajo demanda.
NEXATEC_STORAGE_S3_ENDPOINT=http://127.0.0.1:3900
NEXATEC_STORAGE_S3_REGION=nexatec
NEXATEC_STORAGE_S3_BUCKET=nexatec-media
NEXATEC_STORAGE_S3_ACCESS_KEY=CHANGE_ME
NEXATEC_STORAGE_S3_SECRET_KEY=CHANGE_ME

# Bancard (vPOS). Nombres oficiales -- ver docs/PAYMENTS.md. Vacios =
# el checkout con tarjeta responde 503 explicito, no crashea. Staging
# real requiere cuenta de comercio en https://comercios.bancard.com.py
# (no hay sandbox self-service ni credenciales de prueba publicas).
BANCARD_ENV=staging
# Autoservicio de pago en el portal: APAGADO por decision comercial (la venta
# se cierra por WhatsApp y el pago se registra a mano en el Control Center).
# Las credenciales de Bancard se conservan; prender solo cuando se decida.
NEXATEC_SELF_CHECKOUT_CARD_ENABLED=false
NEXATEC_SELF_CHECKOUT_TRANSFER_ENABLED=false
# Email transaccional (Brevo, https://app.brevo.com > SMTP & API > API Keys).
# Vacio = no se envian emails (recuperacion, invitaciones, avisos de demo);
# el sistema funciona igual. NEXATEC_EMAIL_FROM tiene que ser un remitente o
# dominio VERIFICADO en Brevo, con SPF/DKIM publicados en el DNS.
BREVO_API_KEY=
NEXATEC_EMAIL_FROM=
NEXATEC_EMAIL_FROM_NAME=NEXATEC
# URL publica de la web (para los enlaces de los emails).
NEXATEC_PUBLIC_BASE_URL=http://127.0.0.1:4302
# Numero para los botones "Solicitar por WhatsApp" (solo digitos, con codigo de pais).
NEXATEC_WHATSAPP_NUMBER=595971205040
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
# En development, igual al endpoint (todo en localhost). En staging,
# https://staging.nexatecpy.com/storage (pasa por el BFF de Next.js).
NEXATEC_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3900

# Cloudflare: expone de verdad (DNS + ruta del Tunnel) los hostnames que
# se asignan a tenants -- ver docs/TENANT_HOSTNAME_ROUTING.md y
# app/services/cloudflare_dns.py. Vacios = el hostname queda igual
# registrado en tenant_hostnames pero no se expone a internet, nunca
# bloquea el aprovisionamiento de una demo/produccion (mismo patron que
# Bancard arriba). CLOUDFLARE_API_TOKEN es un API Token acotado (Zone >
# DNS > Edit + Account > Cloudflare Tunnel > Edit, scope solo a esta
# zona/cuenta) creado en https://dash.cloudflare.com/profile/api-tokens
# -- NUNCA la Global API Key.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_SERVICE=http://127.0.0.1:4302
