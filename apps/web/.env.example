# Copiar a .env.local

# Puerto en el que corre este frontend (nunca hardcodeado)
NEXATEC_WEB_PORT=4302

# URL base de la API. En desarrollo, la API nativa en 127.0.0.1.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4301

# Cloudflare Turnstile (FASE 7). Vacio en development: el formulario de
# login envia un token fijo que la API acepta solo si NEXATEC_ENV=development
# y no hay secret key configurada (ver apps/api/app/security/turnstile.py).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
