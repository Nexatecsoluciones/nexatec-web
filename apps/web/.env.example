# Copiar a .env.local (development) o a un EnvironmentFile de systemd
# fuera del repo (staging/production).

NODE_ENV=production
# Nombre logico del entorno funcional. Separado de NODE_ENV a proposito:
# NODE_ENV controla optimizaciones de Next.js (siempre "production" en
# todo despliegue real, incluido staging); NEXATEC_ENV es el que la API
# usa para decidir seguridad (cookies Secure, bypass de Turnstile, etc).
NEXATEC_ENV=development

# Puerto en el que corre este frontend (nunca hardcodeado, nunca 0.0.0.0)
NEXATEC_WEB_PORT=4302

# URL INTERNA de la API, server-only (Server Components + el BFF en
# src/app/api/[...path]/route.ts). NUNCA usar NEXT_PUBLIC_ para esto: si
# llevara ese prefijo, Next.js la incluiria en el bundle del navegador.
NEXATEC_INTERNAL_API_URL=http://127.0.0.1:4301

# URL publica real de este entorno (para construir links absolutos si
# hiciera falta; hoy no es estrictamente necesaria porque todo es
# same-origin, se deja preparada).
NEXATEC_PUBLIC_URL=http://127.0.0.1:4302

# Cloudflare Turnstile. Esta si es NEXT_PUBLIC_ a proposito: la site key
# es publica por diseno de Cloudflare (se usa en el HTML del widget). La
# secret key correspondiente vive SOLO en apps/api/.env, nunca aca.
# Vacio en development: la API acepta un token vacio solo si
# NEXATEC_ENV=development (ver apps/api/app/security/turnstile.py) --
# en staging/production esto es obligatorio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
